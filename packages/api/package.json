{
  "name": "@sale360/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "predev": "pnpm --filter @sale360/db db:generate",
    "dev": "tsx scripts/watchdog.ts",
    "dev:raw": "tsx watch src/index.ts",
